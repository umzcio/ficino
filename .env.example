# Ficino server configuration for docker-compose.yml. Copy to .env (gitignored) and fill in.
# The api and worker services read this file; postgres (which reads only postgres.env, see
# postgres.env.example) and web do not. The settings a deployment usually sets come first; every
# other setting the server reads follows at the end, commented out at its default.
#
# Changing the embedding model (provider, model or dimension) makes the existing chunks invisible
# to search until they are re-embedded:
#   docker compose run --rm --no-deps worker node dist/db/reembed-cli.js   (compose stack)
#   npm run reembed                                                        (source checkout, in server/;
#                                                                           tsx is a dev dependency, pruned from the image)

# --- Database ---------------------------------------------------------------------------------
# <password> is the POSTGRES_PASSWORD from postgres.env.
DATABASE_URL=postgresql://ficino:<password>@postgres:5432/ficino

# --- Server -----------------------------------------------------------------------------------
# production: CORS allows only CORS_ORIGINS, cookies are Secure, and the api and worker refuse to
# start without SIGNED_URL_KEY. development allows the localhost dev origins instead.
ENVIRONMENT=production
# Signs figure and audio URLs; the api and worker must share it. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SIGNED_URL_KEY=
# Comma-separated browser origins allowed to call the API. Use the exact URL people browse to: the API
# also answers only to these hostnames (plus localhost, 127.0.0.1 and ::1), see ALLOWED_HOSTS.
CORS_ORIGINS=https://ficino.example
# none: single owner, no login. basic: email and password accounts.
AUTH_PROVIDER=none
# The path the browser reaches the API under (the prefix the web nginx strips). Empty or a path.
PUBLIC_API_BASE=/ficino/api

# --- Providers --------------------------------------------------------------------------------
# These are the defaults; each user can override them in Settings unless PUBLIC_DEPLOYMENT=true.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen3.8:27b
OLLAMA_EMBED_MODEL=qwen3-embedding:latest
OLLAMA_VISION_MODEL=qwen3-vl:32b
# Must be 1024 (chunks.embedding is vector(1024)).
EMBED_DIM=1024
FIGURE_DETECT_PROVIDER=ollama
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# --- Audio ------------------------------------------------------------------------------------
# Leave the key empty to disable audio (the API answers 501). Both the api and the worker need it.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_DIALOGUE_MODEL_ID=eleven_v3

# --- Jobs -------------------------------------------------------------------------------------
# Per-job time limit in seconds (at least 120).
JOB_TIME_LIMIT_SEC=600
WORKER_INGESTION_CONCURRENCY=1

# --- Everything else (defaults shown) --------------------------------------------------------
# Uncomment only to change a default. Booleans accept 1/0, true/false, yes/no, on/off. Keep a
# comment on its own line: compose reads `KEY=  # note` as the value `# note`.
# Auth and access
#   basic auth: later accounts may register (the first always may)
# ALLOW_REGISTRATION=false
#   true: users cannot override the provider settings in Settings
# PUBLIC_DEPLOYMENT=false
#   Domain attribute of the CSRF cookie; empty: host-only
# COOKIE_DOMAIN=
#   DNS-rebinding guard: the API answers 421 to any Host other than localhost, 127.0.0.1, ::1, the
#   CORS_ORIGINS hostnames and these (comma-separated names, a port is ignored). Add the API's own
#   name if browsers reach it under a different host than the web; * turns the check off.
# ALLOWED_HOSTS=
#   Peers whose X-Real-IP names the client for the login and register limits and the audit log
#   (comma-separated addresses or CIDRs; none: trust no proxy). Empty: loopback and the private
#   ranges, which covers the web nginx on the compose network. Behind your own proxy, see
#   REAL_IP_FROM in deploy/README.md.
# TRUSTED_PROXIES=
# Process (the image sets API_HOST=0.0.0.0; the healthcheck expects PORT 8000)
# API_HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=info
#   connection pools, each at least 2; DB_POOL_MAX_SIZE is the fallback for both
# API_DB_POOL_MAX_SIZE=20
# WORKER_DB_POOL_MAX_SIZE=10
# DB_POOL_MAX_SIZE=
# Storage (the compose volumes are mounted at these paths)
# UPLOAD_DIR=/app/uploads
# FIGURES_DIR=/app/figures
# MEDIA_DIR=/app/media
# MAX_UPLOAD_SIZE_MB=50
#   request body cap in KiB for every route but the PDF upload; larger bodies get 413
# MAX_JSON_BODY_KB=1024
# Provider choices and models
#   ollama, voyage or openai
# EMBED_PROVIDER=ollama
#   ollama or api (Anthropic)
# VISION_PROVIDER=ollama
# CLAUDE_MODEL=claude-sonnet-5-5
# VOYAGE_EMBED_MODEL=voyage-4-large
# OPENAI_EMBED_MODEL=text-embedding-3-small
# FIGURE_DETECT_OLLAMA_MODEL=qwen3-vl:32b
# FIGURE_DETECT_ANTHROPIC_MODEL=claude-sonnet-5-5
# MAX_VISION_PAGES=100
#   an upload with more pages than this is rejected (paper error)
# MAX_PDF_PAGES=500
#   figure detection reads and sends only the first this-many pages
# FIGURE_DETECT_MAX_PAGES=60
#   a PDF page with more characters than this fails the paper (no retry)
# MAX_PAGE_CHARS=200000
#   a paper whose extracted text (PDF or vision) has more characters than this fails (no retry)
# MAX_PAPER_CHARS=3000000
#   heap cap (MB) of the thread that reads one paper's PDF; passing it fails the paper (no retry)
# PDF_THREAD_HEAP_MB=1024
# Contextual chunk prefixes at ingestion
#   none, anthropic or ollama
# CONTEXT_PROVIDER=none
# CONTEXT_ANTHROPIC_MODEL=claude-haiku-5-5
# CONTEXT_OLLAMA_MODEL=qwen3.8:27b
# CONTEXT_MAX_PAPER_CHARS=200000
# CONTEXT_MAX_TOKENS=150
#   a paper with more chunks than this is stored without prefixes (no calls)
# CONTEXT_MAX_CHUNKS=200
# Retrieval and reranking
# RETRIEVAL_VECTOR_WEIGHT=0.7
# RETRIEVAL_KEYWORD_WEIGHT=0.3
# RETRIEVAL_MAX_VECTOR_DISTANCE=0.8
# RETRIEVAL_CANDIDATE_POOL=100
# RETRIEVAL_RERANK_MULTIPLIER=5
#   none, voyage or cohere (local passes through unranked)
# RERANK_PROVIDER=none
# RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_VOYAGE_MODEL=rerank-2-lite
# RERANK_COHERE_MODEL=rerank-v3.5
# SEARCH_USE_NORMALIZED_POSTS=true
# Per-user daily limits
# RATE_LIMIT_UPLOADS_PER_DAY=50
# RATE_LIMIT_GENERATIONS_PER_DAY=20
# RATE_LIMIT_USER_POSTS_PER_DAY=30
# RATE_LIMIT_SUMMARY_PER_DAY=30
# RATE_LIMIT_REPLIES_PER_DAY=60
# RATE_LIMIT_PERSONA_DM_PER_DAY=60
# RATE_LIMIT_AUDIO_PER_DAY=20
