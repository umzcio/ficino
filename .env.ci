# CI environment for the GitHub Actions e2e gate (plan 037). Copied to .env
# by the e2e job before `docker compose up`. DUMMY VALUES ONLY — no secrets
# belong here; the compose stack boots fine without any because every
# provider below is either disabled or deliberately unreachable.
#
# The gated Playwright subset (project `ci` in playwright.config.ts) is
# fixture-runnable: it never needs a working LLM/embed/vision/TTS backend.
# Specs that do (round9_core_flows, wave4_group_chat, R2-S16-09) are excluded
# from the gate — see tests/e2e/SKIPS.md.

# Database / Redis (in-compose hostnames; passwords are the compose defaults)
DATABASE_URL=postgresql://ficino:ficino@postgres:5432/ficino
REDIS_URL=redis://redis:6379/0

# Provider selection — ollama pointed at a DEAD port so any accidental LLM
# dispatch fails fast instead of hanging. No model ever needs to exist.
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:9
OLLAMA_LLM_MODEL=ci-unused
OLLAMA_EMBED_MODEL=ci-unused
OLLAMA_VISION_MODEL=ci-unused
EMBED_DIM=1024

# Dummy API keys — never read, since every provider above is ollama.
ANTHROPIC_API_KEY=ci-dummy-not-a-real-key
OPENAI_API_KEY=ci-dummy-not-a-real-key

# Auth / storage
AUTH_PROVIDER=none
STORAGE_PROVIDER=local
PUBLIC_DEPLOYMENT=false

# App config
ENVIRONMENT=test
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000
CELERY_WORKER_CONCURRENCY=2
