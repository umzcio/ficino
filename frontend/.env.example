# Frontend build-time configuration. Vite inlines VITE_* into the bundle
# at build time, so these must be available to `npm run build` — not at
# container start. In Railway, set these on the frontend service as
# build-time variables.

# Path the browser uses for API calls. It must be a same-origin path equal
# to the server's PUBLIC_API_BASE: the page's Content-Security-Policy allows
# connections, images and media from its own origin only, and the client
# loads post media only from this base. Defaults to /ficino/api when unset.
VITE_API_BASE=/ficino/api

# Supabase client keys — only required when AUTH_PROVIDER=supabase on the
# API side. The anon key is safe to expose to the browser; the
# service-role key is NOT (it lives only in the api + worker env).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Cloudflare Turnstile site key. Required if Supabase Attack Protection
# → Captcha is enabled; leave unset otherwise. The secret half lives on
# Supabase, not here — this one is public.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
